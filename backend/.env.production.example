# PRODUCTION ENVIRONMENT
NODE_ENV=production

# Server
PORT=5000
HOST=0.0.0.0

# Database (Prisma schema currently uses MySQL)
DATABASE_URL=mysql://user:password@db-host:3306/technexus_prod

# JWT (MUST use strong secret - at least 32 characters)
JWT_SECRET=generate-random-32-char-key-using-crypto.randomBytes
JWT_EXPIRE=24h

# Admin Credentials (Database-driven in production)
# Do NOT store in environment - use database with hashed passwords

# CORS (Set to your exact production frontend domain; comma-separate if needed)
CORS_ORIGIN=https://technexus.com
ALLOW_VERCEL_PREVIEWS=false

# Payment — Stripe (live keys)
STRIPE_SECRET_KEY=sk_live_xxxxx
FRONTEND_URL=https://your-frontend-domain.com

# Rate Limiting (Strict for production)
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=50

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/technexus/api.log
