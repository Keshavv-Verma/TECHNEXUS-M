# Environment
NODE_ENV=development

# Server
PORT=5000
HOST=0.0.0.0

# MongoDB Atlas Database (Migrated from MySQL)
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://user:password@your-cluster.mongodb.net/technexus?retryWrites=true&w=majority

# Alternative: DATABASE_URL also works for MongoDB
# DATABASE_URL=mongodb+srv://user:password@your-cluster.mongodb.net/technexus?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=1h

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ALLOW_VERCEL_PREVIEWS=false

# Payment — Stripe (test keys from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_xxxxx
FRONTEND_URL=http://localhost:3000

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
# Use keyword-based recommendations when Gemini fails (default: true)
AI_USE_FALLBACK=true

# Checkout / E-commerce
FREE_DELIVERY_THRESHOLD=999
SHIPPING_CHARGE=49
GST_RATE=0.18
BUSINESS_DAYS_MIN=5
BUSINESS_DAYS_MAX=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
