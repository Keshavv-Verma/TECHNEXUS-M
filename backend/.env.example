# Environment
NODE_ENV=development

# Server
PORT=5000
HOST=0.0.0.0

# MongoDB Atlas Database (Migrated from MySQL)
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://user:password@your-cluster.mongodb.net/technexus?retryWrites=true&w=majority

# Alternative: DATABASE_URL also works for MongoDB
# DATABASE_URL=mongodb+srv://user:password@your-cluster.mongodb.net/technexus?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=1h

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ALLOW_VERCEL_PREVIEWS=false

# Payment Gateways (Optional)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# Checkout / E-commerce
FREE_DELIVERY_THRESHOLD=999
SHIPPING_CHARGE=49
GST_RATE=0.18
BUSINESS_DAYS_MIN=5
BUSINESS_DAYS_MAX=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
